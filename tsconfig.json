{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/core": ["./src/core"],
      "@/core/*": ["./src/core/*"],
      "@/features": ["./src/features"],
      "@/features/*": ["./src/features/*"],
      "@/ui": ["./src/ui"],
      "@/ui/*": ["./src/ui/*"],
      "@/data": ["./src/data"],
      "@/data/*": ["./src/data/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
