TTS_PROVIDER=device

# Local Piper/Kokoro OpenAI-compatible proxy, e.g. http://192.168.1.10:5000/v1
EXPO_PUBLIC_TTS_BASE_URL=
EXPO_PUBLIC_TTS_MODEL=tts-1
EXPO_PUBLIC_TTS_VOICE_ID=en_US-lessac-medium
# Optional. Leave empty for a local Piper that does not require a key.
EXPO_PUBLIC_TTS_API_KEY=
# OpenRouteService free key (no credit card). Sign up at https://openrouteservice.org
# Used for routing alternatives, loops, and elevation. Prefix EXPO_PUBLIC_ so Metro inlines it.
EXPO_PUBLIC_ORS_API_KEY=

# Valhalla public instance for twisty routing. No key. Override only if you self-host.
# Default community server: https://valhalla1.openstreetmap.de
EXPO_PUBLIC_VALHALLA_URL=https://valhalla1.openstreetmap.de

# TTS backend. Never a paid vendor.
# device = expo-speech (live, offline, robotic)
# http   = OpenAI-compatible HTTP (point at local Piper/Kokoro). Recce caches clips.
EXPO_PUBLIC_TTS_PROVIDER=device
